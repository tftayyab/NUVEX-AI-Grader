# Copy this file to .env and fill in your values:
#   copy .env.example .env

# Free MongoDB Atlas URI
# 1. Create account at https://www.mongodb.com/cloud/atlas
# 2. Create a free M0 cluster
# 3. Database Access -> add user
# 4. Network Access -> Allow Access from Anywhere (0.0.0.0/0) for testing
# 5. Connect -> Drivers -> copy connection string
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/nuvex_grader?retryWrites=true&w=majority

PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# CAD file upload on the student form.
# Keep false while you test text + pictures first.
ENABLE_CAD=false

# Local Ollama models (already pulled — do not pull extra models)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_TEXT_MODEL=llama3.2:3b
OLLAMA_VISION_MODEL=qwen3-vl:2b-instruct

# CPU-only settings for an older i5 with 16GB RAM and integrated graphics.
OLLAMA_NUM_THREADS=4
OLLAMA_NUM_CTX=4096

# Allow up to 30 minutes for local inference; grading runs in a background job so the browser stays connected.
OLLAMA_TIMEOUT_MS=1800000

# Keep false for faster grading: one vision call per image question instead of two.
OLLAMA_TWO_PASS_VISION=false
